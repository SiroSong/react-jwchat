{
  "compilerOptions": {
    "strict": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "jsx": "react",
    "paths": {
      "@@/*": ["./.dumi/tmp/*"],
      "@/*": ["./src/*"],
      "react-jwchat": ["./src"],
      "react-jwchat/*": ["./src/*", "./*"]
    }
  },
  "include": [".dumirc.ts", "src/**/*", "demo"]
}
